name: Auto Fetch News
on:
  schedule:
    - cron: '0 * * * *' # 每小時自動抓取一次
  workflow_dispatch: # 支援手動按鈕觸發

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: 檢查程式碼
        uses: actions/checkout@v3

      - name: 設定 Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.x'

      - name: 執行新聞抓取
        run: python fetch_news.py

      - name: 更新新聞資料至網站
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.name "github-actions[bot]@users.noreply.github.io"
          git add news.json
          git commit -m "Auto update real news" || exit 0
          git push
